-- ==========================================
-- 3. ESP LOGIC
-- ==========================================
local function applyESP(targetChar)
	if not targetChar or targetChar == character then return end
	if not targetChar:FindFirstChild("ESPHighlight") then
		local highlight = Instance.new("Highlight")
		highlight.Name = "ESPHighlight"
		highlight.FillColor = Color3.fromRGB(255, 0, 50)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = targetChar
	end
end

local function removeESP(targetChar)
	if not targetChar then return end
	local highlight = targetChar:FindFirstChild("ESPHighlight")
	if highlight then highlight:Destroy() end
end

local function updateAllESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			if isESPEnabled then applyESP(p.Character) else removeESP(p.Character) end
		end
	end
end

espBtn.Activated:Connect(function()
	isESPEnabled = not isESPEnabled
	espBtn.Text = isESPEnabled and "ESP: ON" or "ESP: OFF"
	espBtn.BackgroundColor3 = isESPEnabled and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(35, 35, 35)
	updateAllESP()
end)

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function(c) if isESPEnabled then applyESP(c) end end)
end)

-- ==========================================
-- 4. PHYSICAL WELD SEAT CARRY LOGIC
-- ==========================================
local function getClosestPlayer()
	local closestPlayer = nil
	local shortestDistance = CARRY_RANGE

	if not rootPart then return nil end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local targetRoot = p.Character.HumanoidRootPart
			local dist = (targetRoot.Position - rootPart.Position).Magnitude
			if dist < shortestDistance then
				shortestDistance = dist
				closestPlayer = p
			end
		end
	end
	return closestPlayer
end

local function dropPlayer()
	isCarrying = false
	if carryWeld then
		carryWeld:Destroy()
		carryWeld = nil
	end
	carriedPlayer = nil
	carryBtn.Text = "CARRY: OFF"
	carryBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
end

local function toggleCarry()
	if isCarrying then
		dropPlayer()
		return
	end

	local target = getClosestPlayer()
	if target and target.Character then
		local targetHum = target.Character:FindFirstChild("Humanoid")
		
		if targetHum and targetHum.SeatPart then
			local seat = targetHum.SeatPart
			seat.Anchored = false

			-- Position the seat directly in front of local player
			seat.CFrame = rootPart.CFrame * CFrame.new(0, 1, -4)

			-- Create a physical WeldConstraint so physics replicates to the server
			carryWeld = Instance.new("WeldConstraint")
			carryWeld.Name = "SeatCarryWeld"
			carryWeld.Part0 = rootPart
			carryWeld.Part1 = seat
			carryWeld.Parent = rootPart

			carriedPlayer = target
			isCarrying = true

			carryBtn.Text = "DROP: " .. string.sub(target.DisplayName, 1, 7)
			carryBtn.BackgroundColor3 = Color3.fromRGB(230, 126, 34)
		else
			-- Notify player if target isn't sitting down
			carryBtn.Text = "NOT IN SEAT!"
			task.delay(1.5, function()
				if not isCarrying then
					carryBtn.Text = "CARRY: OFF"
				end
			end)
		end
	end
end

carryBtn.Activated:Connect(toggleCarry)

-- Safely drop if player leaves or un-seats
RunService.Heartbeat:Connect(function()
	if isCarrying and carriedPlayer and carriedPlayer.Character then
		local targetHum = carriedPlayer.Character:FindFirstChild("Humanoid")
		if not targetHum or not targetHum.SeatPart or targetHum.Health <= 0 then
			dropPlayer()
		end
	end
end)

-- ==========================================
-- 5. FLIGHT LOGIC
-- ==========================================
local function toggleFlight()
	isFlying = not isFlying
	flyBtn.Text = isFlying and "FLY: ON" or "FLY: OFF"
	flyBtn.BackgroundColor3 = isFlying and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(35, 35, 35)

	if isFlying then
		humanoid.PlatformStand = true
		attachment = Instance.new("Attachment", rootPart)

		linearVelocity = Instance.new("LinearVelocity", rootPart)
		linearVelocity.Attachment0 = attachment
		linearVelocity.MaxForce = 10000000
		linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World

		alignOrientation = Instance.new("AlignOrientation", rootPart)
		alignOrientation.Attachment0 = attachment
		alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
		alignOrientation.MaxTorque = 10000000
		alignOrientation.Responsiveness = 200
	else
		humanoid.PlatformStand = false
		if linearVelocity then linearVelocity:Destroy() end
		if alignOrientation then alignOrientation:Destroy() end
		if attachment then attachment:Destroy() end
		
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = true end
		end
	end
end

flyBtn.Activated:Connect(toggleFlight)

-- PC Hotkeys (E = Fly, Q = ESP, R = Carry)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E then toggleFlight() end
	if input.KeyCode == Enum.KeyCode.R then toggleCarry() end
	if input.KeyCode == Enum.KeyCode.Q then 
		isESPEnabled = not isESPEnabled
		espBtn.Text = isESPEnabled and "ESP: ON" or "ESP: OFF"
		espBtn.BackgroundColor3 = isESPEnabled and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(35, 35, 35)
		updateAllESP()
	end
end)

-- Frame Updates (Noclip & Flight Movement)
RunService.Stepped:Connect(function()
	if isFlying and character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not isFlying or not rootPart or not humanoid or not linearVelocity then return end

	local camera = workspace.CurrentCamera
	alignOrientation.CFrame = camera.CFrame

	local moveDirection = humanoid.MoveDirection
	local flyVector = Vector3.zero

	if moveDirection.Magnitude > 0 then
		local camCFrame = camera.CFrame
		local flatLook = Vector3.new(camCFrame.LookVector.X, 0, camCFrame.LookVector.Z).Unit
		local flatRight = Vector3.new(camCFrame.RightVector.X, 0, camCFrame.RightVector.Z).Unit
		
		local forwardAmount = moveDirection:Dot(flatLook)
		local rightAmount = moveDirection:Dot(flatRight)
		
		flyVector = (camCFrame.LookVector * forwardAmount) + (camCFrame.RightVector * rightAmount)
	end

	if humanoid.Jump or moveUpMobile then
		flyVector = flyVector + Vector3.new(0, 1, 0)
	elseif moveDownMobile then
		flyVector = flyVector + Vector3.new(0, -1, 0)
	end

	if flyVector.Magnitude > 0 then
		linearVelocity.VectorVelocity = flyVector.Unit * FLY_SPEED
	else
		linearVelocity.VectorVelocity = Vector3.zero
	end
end)

player.CharacterAdded:Connect(function(newChar)
	character = newChar
	humanoid = character:WaitForChild("Humanoid")
	rootPart = character:WaitForChild("HumanoidRootPart")
	isFlying = false
	dropPlayer()
	flyBtn.Text = "FLY: OFF"
	flyBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
end)

Players.PlayerRemoving:Connect(function(leavingPlayer)
	if isCarrying and leavingPlayer == carriedPlayer then dropPlayer() end
end)
