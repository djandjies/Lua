-- ==========================================
-- 2. TOUCH & SLIDER LOGIC
-- ==========================================
local isDraggingSlider = false

local function updateSlider(input)
	local trackSize = sliderTrack.AbsoluteSize.X
	local trackPos = sliderTrack.AbsolutePosition.X
	if trackSize <= 0 then return end
	
	local relativePos = math.clamp(input.Position.X - trackPos, 0, trackSize)
	local percentage = relativePos / trackSize
	
	sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
	FLY_SPEED = math.floor(MIN_SPEED + ((MAX_SPEED - MIN_SPEED) * percentage))
	speedLabel.Text = "SPEED: " .. FLY_SPEED
end

sliderTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = true
		updateSlider(input)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateSlider(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = false
	end
end)

